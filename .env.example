# Runtime configuration for the Ferry Timetable Notice Board.
# Every value below has an in-code default; copy this file to .env only if you
# want to change them. The app never requires a .env file to boot.

# Port the HTTP server listens on.
PORT=3000

# Interface to bind. 0.0.0.0 keeps the board reachable from other machines.
HOST=0.0.0.0

# Staff session lifetime in minutes.
SESSION_TTL_MINUTES=720

# Directory that holds the JSON datastore (db.json).
DATA_DIR=./data

# Set to true only when the board is served over HTTPS, so the session cookie
# gains the Secure flag. Leave false for local HTTP use.
COOKIE_SECURE=false

# Optional overrides for the seeded demo staff credentials. Leave empty to use
# the built-in non-production demo fallbacks (cenius@cenius.ai / cenius).
DEMO_STAFF_PASSWORD=
DEMO_ALT_STAFF_PASSWORD=
